      "name": "FlowSaaS Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -140
      ],
      "parameters": {
        "content": "FlowSaaS v1.0.0 — setup guide: https://flowsaas.com/workflows/abandoned-cart-recovery-messenger-email\n\nConnect your own credentials in each node marked with a warning icon. No credentials are included in this file.",
        "height": 100,
        "width": 460
      }
    },
    {
      "id": "267994bf-ba07-6b8e-eebd-033e7d145095",
