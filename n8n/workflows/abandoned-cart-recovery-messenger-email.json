      "typeVersion": 2,
      "position": [
        979.9999999999999,
        64
      ],
      "parameters": {},
      "notes": "Checks whether this customer has an active Messenger opt-in. (needs: Airtable personal access token)",
      "notesInFlow": false
    },
    {
      "id": "f82f96a6-6760-156d-3659-4f463dce872a",
      "name": "Send Messenger Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        979.9999999999999,
        224
      ],
      "parameters": {},
      "notes": "Sends a reminder if opted in and within the messaging window. (needs: Facebook Page access token)",
      "notesInFlow": false
    },
    {
      "id": "7a1d97a0-56d5-afd2-a695-4cb68d1c88ec",
      "name": "Wait (Email Delay)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        672,
        224
      ],
      "parameters": {},
      "notes": "Waits until the 24-hour mark before emailing.",
      "notesInFlow": false
