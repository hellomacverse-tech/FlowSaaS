      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        56,
        224
      ],
      "parameters": {},
      "notes": "Creates a single-use discount code via the Shopify API. (needs: Shopify Admin API access token)",
      "notesInFlow": false
    },
    {
      "id": "bf5144e5-928f-0c94-ce49-b0c05f0587cb",
      "name": "Draft Recovery Email",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        56,
        384
      ],
      "parameters": {},
      "notes": "Personalizes the follow-up email using the cart contents. (needs: OpenAI API key)",
      "notesInFlow": false
    },
    {
      "id": "d2b74e75-82c3-fcbe-fe83-97b9dd2c1caf",
      "name": "Send Recovery Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        364,
        384
      ],
      "parameters": {},
      "notes": "Sends the follow-up email with the discount code. (needs: Gmail OAuth)",
      "notesInFlow": false
    },
    {
      "id": "13fe4c0a-3f4e-2480-eeb7-7757183b5e5c",
      "name": "Log Recovery Attempt",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [
        672,
        384
      ],
      "parameters": {},
      "notes": "Records the attempt and outcome. (needs: Airtable personal access token)",
      "notesInFlow": false
    },
    {
      "id": "cfd77310-1405-59b6-818a-b2574ad4c8a9",
      "name": "Consent Guard",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        979.9999999999999,
        384
      ],
      "parameters": {},
      "notes": "Blocks messaging to customers without valid opt-in/consent.",
      "notesInFlow": false
    },
    {
      "id": "1fa2544b-270e-f9ac-b55b-fbfd7ca58318",
      "name": "Frequency Cap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        979.9999999999999,
        544
      ],
      "parameters": {},
      "notes": "Prevents re-targeting the same cart more than once.",
      "notesInFlow": false
    },
    {
      "id": "fc565bfe-b2b7-8df9-3dc4-e372d48f266e",
      "name": "Error Handler",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        672,
        544
      ],
      "parameters": {},
      "notes": "Logs failures in the recovery sequence. (needs: Airtable personal access token)",
      "notesInFlow": false
    }
  ],
