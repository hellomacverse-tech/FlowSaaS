    {
      "id": "d9cf6463-5d19-ff1f-5a31-9925bfdbed8d",
      "name": "Check Order Completed Again",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        364,
        224
      ],
      "parameters": {},
      "notes": "Re-confirms the cart is still unrecovered. (needs: Shopify Admin API access token)",
      "notesInFlow": false
    },
    {
      "id": "fad15d83-2848-8c59-84a9-e68b4a76db1e",
