    },
    {
      "id": "5872099c-1f31-8125-c83d-dcff474fb015",
      "name": "Check Order Completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        672,
        64
      ],
      "parameters": {},
      "notes": "Confirms the cart wasn't completed while waiting. (needs: Shopify Admin API access token)",
      "notesInFlow": false
    },
    {
      "id": "b292ec6b-2620-d7e1-2951-caa7fee8a3d4",
