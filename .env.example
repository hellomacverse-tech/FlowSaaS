# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://flowsaas.com

# --- Supabase (Postgres, Auth, Storage) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never bundled to the client

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_VIP_ANNUAL=

# --- n8n (self-hosted, queue mode, never exposed to the browser) ---------
N8N_BASE_URL=https://n8n.flowsaas.com
N8N_WEBHOOK_SIGNING_SECRET=                    # HMAC secret shared with n8n
N8N_SANDBOX_WEBHOOK_PATH=/webhook/flowsaas-sandbox
N8N_TOOLS_WEBHOOK_BASE=/webhook/tools
N8N_MODE=mock                                  # mock = in-process runner (dev/CI); live = call n8n

# --- Encryption ------------------------------------------------------------
ENCRYPTION_KEY_BASE64=                         # 32 bytes, base64, AES-256-GCM for stored user n8n API keys

# --- Upstash Redis (rate limiting) -----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (bot protection) ---------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare's public always-passes TEST key — safe for local dev
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA     # Cloudflare's matching TEST secret — replace both with real keys before launch

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=

# --- Analytics & error monitoring ------------------------------------------
POSTHOG_KEY=
SENTRY_DSN=

# --- Feature flags -----------------------------------------------------------
ALLOW_AI_CRAWLERS=true                # allow GPTBot/ClaudeBot/PerplexityBot on marketing pages
NEXT_PUBLIC_SHOW_SEED_CONTENT=false   # true only in preview/staging to show flagged seed testimonials
